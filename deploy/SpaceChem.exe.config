<?xml version="1.0" encoding="utf-8"?>
<!-- SpeechChem hookup. REPLACES the stock SpaceChem.exe.config (which only says
     <supportedRuntime version="v2.0.50727"/>); restoring that file = a fully vanilla launch.

     1. CLR 4 instead of CLR 2. The mod (and Harmony/Mono.Cecil) are .NET Framework 4.x assemblies;
        the game itself is CLR 2 IL and runs unchanged on CLR 4 (verified).
     2. NetFx40_LegacySecurityPolicy: Program.Main runs the game in a second AppDomain through
        AppDomain.ExecuteAssembly(file, new Evidence(), args). That Evidence overload implicitly uses
        CAS policy, which CLR 4 rejects with NotSupportedException unless this switch is on (verified:
        the process exits before the window opens without it).
     3. appDomainManager*: the CLR instantiates SpeechChem.Bootstrap in every AppDomain before any
        game code runs; it hooks the game inside the "SANDBOX" domain (see src/Bootstrap.cs). The
        assembly display name must match the built SpeechChem assembly exactly — AssemblyVersion is
        pinned to 1.0.0.0 in SpeechChem.csproj for that reason. -->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0"/>
  </startup>
  <runtime>
    <NetFx40_LegacySecurityPolicy enabled="true"/>
    <appDomainManagerAssembly value="SpeechChem, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
    <appDomainManagerType value="SpeechChem.Bootstrap" />
  </runtime>
</configuration>
